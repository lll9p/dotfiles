default_shell "nu"

default_layout "compact"

default_mode "normal"

mouse_mode true

// ------------------------------------------------------------
// UI
// ------------------------------------------------------------

// Reduce visual noise while keeping the terminal's ANSI palette.
pane_frames false
simplified_ui true
theme "dayfox"

// Hide the autogenerated session name from the UI title.
ui {
    pane_frames {
        hide_session_name true
    }
}

show_startup_tips false
show_release_notes false

plugins {
    compact-bar location="zellij:compact-bar" {
        tooltip "F1"
    }
}


// ------------------------------------------------------------
// Keybindings
// ------------------------------------------------------------

keybinds {
    // Use one global unbind node; Zellij only reads the first.
    unbind "Ctrl q" "Ctrl p" "Ctrl n" "Ctrl s" "Ctrl o" "Ctrl h" "Alt f" "Alt n" "Alt j" "Alt Down" "Alt k" "Alt Up" "Alt =" "Alt +" "Alt -" "Alt [" "Alt ]" "Alt p" "Alt Shift p"
}

default_shell "nu"

default_layout "compact"

default_mode "normal"

mouse_mode true

// ------------------------------------------------------------
// UI
// ------------------------------------------------------------

// Reduce visual noise while keeping the terminal's ANSI palette.
pane_frames false
simplified_ui true
theme "dayfox"

// Hide the autogenerated session name from the UI title.
ui {
    pane_frames {
        hide_session_name true
    }
}

show_startup_tips false
show_release_notes false


// ------------------------------------------------------------
// Keybindings
// ------------------------------------------------------------

keybinds {
    // Release Zellij's native Ctrl shortcuts.
    unbind "Ctrl g"
    unbind "Ctrl q"
    unbind "Ctrl p"
    unbind "Ctrl n"
    unbind "Ctrl s"
    unbind "Ctrl o"
    unbind "Ctrl t"
    unbind "Ctrl h"

    // Release Zellij's native Alt shortcuts too.
    // This makes Zellij effectively behave like a prefix-based
    // multiplexer rather than globally intercepting shortcuts.
    unbind "Alt f"
    unbind "Alt n"
    unbind "Alt i"
    unbind "Alt o"
    unbind "Alt h"
    unbind "Alt Left"
    unbind "Alt l"
    unbind "Alt Right"
    unbind "Alt j"
    unbind "Alt Down"
    unbind "Alt k"
    unbind "Alt Up"
    unbind "Alt ="
    unbind "Alt +"
    unbind "Alt -"
    unbind "Alt ["
    unbind "Alt ]"
    unbind "Alt p"
    unbind "Alt Shift p"
}
